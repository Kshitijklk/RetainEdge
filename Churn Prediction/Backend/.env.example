NODE_ENV=development
PORT=5000
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,http://localhost:3000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://prathambansal2307_db_user:6359183473@cluster0.88fpj2v.mongodb.net/retainedge?appName=Cluster0
# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Firebase Admin (Firebase Console > Project Settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# keep the quotes and the \n characters exactly as in the JSON file
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# SMTP for OTP emails (Gmail: use an App Password). If empty in development, OTP is printed in the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RetainEdge <no-reply@retainedge.com>"

# Uploads
MAX_UPLOAD_MB=500
UPLOAD_DIR=uploads

# ML service: "mock" works without the model. Switch to "http" when the Python service is ready.
ML_MODE=mock
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=
ML_TIMEOUT_MS=600000

# Risk thresholds
RISK_HIGH_THRESHOLD=0.7
RISK_MEDIUM_THRESHOLD=0.4
